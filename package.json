{
  "name": "codex-for-opencode",
  "version": "0.3.0",
  "private": true,
  "description": "Codex CLI tools and bundled skill for OpenCode",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "plugin",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "check": "npm run check:types && npm run check:skills",
    "check:types": "tsc --noEmit",
    "check:skills": "node scripts/check-skills.mjs",
    "test": "npm run check && node --test scripts/plugin.test.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.26",
    "yaml": "^2.8.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  }
}
